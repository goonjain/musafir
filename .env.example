# ==========================================
# Musafir / Raahi Environment Configuration
# ==========================================

# 1. Database Configuration (Managed PostgreSQL or Local PostgreSQL)
# Example managed providers: Supabase, Neon, Render, Railway, AWS RDS
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musafir_db

# 2. Admin Moderation Secret Key
# Required in 'X-Admin-Token' header for admin endpoints (/api/admin/*)
ADMIN_SECRET_KEY=musafir_jaipur_admin_key_2026

# 3. Community Abuse and Moderation Rules
RATE_LIMIT_MINUTES=45
STALE_WINDOW_MINUTES=120
DAILY_POINTS_CAP=100
POINTS_PER_CHECKIN=20
POINTS_FOR_GEM_APPROVAL=50

# 4. Frontend API Endpoint
# Points the Vite / React frontend to the FastAPI server
VITE_API_URL=http://localhost:8000/api
